# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-string-in-production

# Database
# Leave DATABASE_URL unset to use a zero-config local SQLite file
# (pbqms_dev.sqlite3) — no server to install or start.
# To use MySQL instead, uncomment one of the lines below:
# DATABASE_URL=mysql+pymysql://pbqms_user:pbqmspass@localhost/pbqms_dev
# For Docker: DATABASE_URL=mysql+pymysql://pbqms_user:pbqmspass@db/pbqms

# Redis / Celery (optional — threads used if not available)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# SMS Provider: mock | dialog | mobitel | textlk | twilio
SMS_PROVIDER=mock

# Dialog Sri Lanka
DIALOG_USER=your_dialog_username
DIALOG_PASS=your_dialog_password
DIALOG_SENDER_ID=PPLSBANK

# Mobitel
MOBITEL_TOKEN=your_mobitel_bearer_token
MOBITEL_SENDER_ID=PPLSBANK

# Text.lk
TEXTLK_API_TOKEN=your_textlk_api_token
TEXTLK_SENDER_ID=PPLSBANK

# Twilio
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token
TWILIO_FROM=+1415XXXXXXX

# Base URL for QR codes
BASE_URL=http://localhost:5000
