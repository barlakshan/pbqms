# ─── Flask ───────────────────────────────────────────
FLASK_APP=wsgi.py
FLASK_ENV=development

# Change this in production!
SECRET_KEY=pb-qems-secret-key-change-this-in-production-2025

# ─── Database ────────────────────────────────────────
# Leave DATABASE_URL unset/commented to use a zero-config local SQLite file
# (pbqms_dev.sqlite3, created automatically) — no MySQL server required.
#
# To use MySQL instead, start your MySQL server (e.g. XAMPP) first, then
# uncomment ONE of the lines below and set the correct credentials:
#   XAMPP default:   DATABASE_URL=mysql+pymysql://root:@localhost/pbqms_dev
#   MySQL default:   DATABASE_URL=mysql+pymysql://root:root@localhost/pbqms_dev
#   Custom password: DATABASE_URL=mysql+pymysql://root:YourPassword@localhost/pbqms_dev

# ─── SMS (leave as mock for testing) ─────────────────
SMS_PROVIDER=mock

# ─── Redis / Celery (optional for development) ───────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ─── Base URL for QR codes ───────────────────────────
BASE_URL=http://localhost:5000
